// Azure Static Web App on the Free plan, hosting the built single-page app (dist/).
// It is not linked to a repository: build locally and upload with the SWA CLI, as in the README's
// "Deploying to Azure" section. Routing and headers come from public/staticwebapp.config.json.

@description('Name of the Static Web App resource. Its public host name is generated by Azure (*.azurestaticapps.net).')
@minLength(2)
@maxLength(40)
param name string = 'solar-system-sim'

@description('Region for the app\'s metadata. The content itself is served from Azure\'s global edge; only these regions can host Static Web Apps.')
@allowed([
  'westus2'
  'centralus'
  'eastus2'
  'westeurope'
  'eastasia'
])
// Not westeurope: it has stopped accepting new Static Web Apps for some subscriptions.
param location string = 'eastus2'

@description('Tags for the resource.')
param tags object = {}

resource site 'Microsoft.Web/staticSites@2024-04-01' = {
  name: name
  location: location
  tags: tags
  sku: {
    name: 'Free'
    tier: 'Free'
  }
  properties: {
    // Let staticwebapp.config.json in each upload set routing and headers.
    allowConfigFileUpdates: true
  }
}

// The deployment token is a secret, so it is not an output (outputs are kept in the deployment history).
// Fetch it when deploying: az staticwebapp secrets list --name <name> --query properties.apiKey -o tsv
output name string = site.name
output url string = 'https://${site.properties.defaultHostname}'
